<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key>
  <string>gpui-chat-clone</string>
  <key>CFBundleIdentifier</key>
  <string>com.openai.gpui-chat-clone.capture</string>
  <key>CFBundleName</key>
  <string>GPUI Capture</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <!-- A regular app, not an agent: Computer Use only lists apps macOS treats as
       user-facing, and an LSUIElement bundle never appears in its inventory
       (2026-09-22: `listApps` omitted it and `getApp` timed out, while the same
       bundle with LSUIElement=false appeared and bound immediately). Set
       GPUI_CAPTURE_AGENT_APP=1 when packaging to restore the agent behaviour
       for a capture that must not show a Dock icon. -->
  <key>LSUIElement</key>
  <false/>
  <key>NSHighResolutionCapable</key>
  <true/>
  <!-- The in-app browser loads any site, including plain http and local
       servers, like a browser rather than an app talking to its own API. -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsArbitraryLoadsInWebContent</key>
    <true/>
    <key>NSAllowsLocalNetworking</key>
    <true/>
  </dict>
  <!-- WebKit asks macOS for these when a page requests them; without a
       usage string the system terminates the app instead of prompting. -->
  <key>NSCameraUsageDescription</key>
  <string>Websites in the built-in browser can ask to use your camera.</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>Websites in the built-in browser can ask to use your microphone.</string>
  <key>NSLocationUsageDescription</key>
  <string>Websites in the built-in browser can ask for your location.</string>
  <key>NSLocationWhenInUseUsageDescription</key>
  <string>Websites in the built-in browser can ask for your location.</string>
</dict>
</plist>
